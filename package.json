{
    "name": "js-ts-webdev-tasks",
    "version": "1.0.0",
    "description": "Your team task is to implement Frontend and Backend for E-Commerce Website",
    "main": "main.js",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "eslint": "eslint src --fix",
        "prettier": "prettier src --write",
        "prepare": "husky",
        "buildCSS": "tailwindcss -i ./src/style.css -o ./src/buildStyle.css --watch"
    },
    "lint-staged": {
        "src/**/*": [
            "prettier --write --ignore-unknown",
            "eslint --fix"
        ]
    },
    "author": "",
    "license": "ISC",
    "dependencies": {
        "navigo": "^8.11.1",
        "typescript": "^5.7.2",
        "vite": "^6.0.3"
    },
    "devDependencies": {
        "@eslint/js": "^9.16.0",
        "css-loader": "^7.1.2",
        "eslint": "^9.16.0",
        "eslint-config-prettier": "^9.1.0",
        "husky": "^9.1.7",
        "lint-staged": "^15.2.11",
        "prettier": "3.4.2",
        "style-loader": "^4.0.0",
        "tailwindcss": "^3.4.16",
        "typescript-eslint": "^8.18.0"
    }
}
